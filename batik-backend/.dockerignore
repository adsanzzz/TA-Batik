# Python
__pycache__
*.pyc
*.pyo
.venv
venv
env

# Block user-uploaded files from bloating the image (they live in a Docker volume)
# But ALLOW template files that must be baked into the image!
uploads/*
!uploads/shirt_template.png
!uploads/blouse_template.png

# Secrets & local config
.env
.env.*

# Models are downloaded during build via wget; don't copy local copies in
models

# RAG runtime data (Qdrant file fallback & HF model cache) — live in volumes
local_qdrant_storage
hf_cache

# Dev tooling
.git
.gitignore
.vscode
.idea
.DS_Store
README.md
*.log
